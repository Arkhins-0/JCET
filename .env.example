# ---- Database (NeonDB PostgreSQL serverless) ----
# Pooled connection (used by the app at runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require&pgbouncer=true"
# Direct connection (used by prisma migrate / introspection)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ---- NextAuth v5 ----
# Generate with: npx auth secret   (or: openssl rand -base64 32)
NEXTAUTH_SECRET="replace-with-a-long-random-secret"
AUTH_SECRET="replace-with-a-long-random-secret"
# Local: http://localhost:3000  |  Vercel: https://your-app.vercel.app
NEXTAUTH_URL="http://localhost:3000"
# Required for Auth.js v5 on Vercel.
AUTH_TRUST_HOST="true"

# ---- Seed admin (used by prisma/seed.ts) ----
SEED_ADMIN_EMAIL="admin@jawaharlalcolleges.com"
SEED_ADMIN_PASSWORD="Admin@JCET2026"

# ---- Public site config (baked into the client bundle at build time) ----
# Public site URL (used for SEO / canonical / sitemap)
NEXT_PUBLIC_SITE_URL="https://jawaharlalcolleges.com"
# Floating WhatsApp CTA number (country code + number, no +)
NEXT_PUBLIC_WHATSAPP_NUMBER="918592884777"
# Online admissions portal (external) — used by "Apply Now"
NEXT_PUBLIC_APPLY_URL="https://admissions.nehrucolleges.com/application-form"
# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=""

# ---- Optional: point the client at a different API origin ----
# Leave unset to use this app's own /api routes (same origin, recommended).
# NEXT_PUBLIC_API_URL="https://your-app.vercel.app"
